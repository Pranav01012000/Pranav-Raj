{{ 'loomhaus-hero.css' | asset_url | stylesheet_tag }}
{%- assign card_product = section.settings.card_product -%}

<section class="lh-section lh-hero">
  <div class="lh-container lh-hero__inner">

    {%- comment -%} Left column: copy {%- endcomment -%}
    <div class="lh-hero__content">
      {%- if section.settings.badge != blank -%}
        <span class="lh-hero__badge">{{ section.settings.badge }}</span>
      {%- endif -%}

      <h1 class="lh-hero__heading">{{ section.settings.heading }}</h1>
      <p class="lh-hero__text">{{ section.settings.text }}</p>

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="lh-hero__btn">
          <span>{{ section.settings.button_label }}</span>
          {%- comment -%} Arrow slides right on hover (see CSS) {%- endcomment -%}
          <svg class="lh-hero__btn-arrow" width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}

      {%- comment -%} Stats: one block per stat {%- endcomment -%}
      <dl class="lh-hero__stats">
        {%- for block in section.blocks -%}
          <div class="lh-hero__stat" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.value }}</dt>
            <dd>{{ block.settings.label }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    </div>

    {%- comment -%} Right column: image, decorative circle and floating card {%- endcomment -%}
    <div class="lh-hero__media">
      <span class="lh-hero__circle" aria-hidden="true"></span>

      <div class="lh-hero__image">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag:
              loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200',
              sizes: '(min-width: 750px) 45vw, 100vw', alt: section.settings.image.alt }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'lh-hero__placeholder' }}
        {%- endif -%}
      </div>

      {%- comment -%} Floating card: product comes from the customizer, caption is free text {%- endcomment -%}
      {%- if card_product != blank or section.settings.card_title != blank -%}
        <div class="lh-hero__card">
          {%- if card_product.featured_image != blank -%}
            <span class="lh-hero__card-thumb">
              {{ card_product.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
            </span>
          {%- endif -%}
          <span class="lh-hero__card-text">
            <strong>{{ card_product.title | default: section.settings.card_title }}</strong>
            <small>{{ section.settings.card_caption }}</small>
          </span>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Loomhaus hero",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "New season · Autumn / Winter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Winter Edit" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Warm layers, honest fabrics and fits that work every day. Discover the pieces our community wears on repeat this season." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },

    { "type": "header", "content": "Floating card" },
    { "type": "product", "id": "card_product", "label": "Product (image and title)" },
    { "type": "text", "id": "card_title", "label": "Fallback title (if no product)" },
    { "type": "text", "id": "card_caption", "label": "Caption", "default": "Bestseller this week" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "4.8★" },
        { "type": "text", "id": "label", "label": "Label", "default": "2,000+ reviews" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Loomhaus hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "4.8★", "label": "2,000+ reviews" } },
        { "type": "stat", "settings": { "value": "100%", "label": "organic cotton" } },
        { "type": "stat", "settings": { "value": "30 days", "label": "free returns" } }
      ]
    }
  ]
}
{% endschema %}