{{ 'loomhaus-grid.css' | asset_url | stylesheet_tag }}
<section class="lh-section lh-grid">
  <div class="lh-container">

    {%- comment -%} Heading row {%- endcomment -%}
    <div class="lh-grid__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="lh-grid__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="lh-grid__heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.hint != blank -%}
        <p class="lh-grid__hint">{{ section.settings.hint }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Tiles {%- endcomment -%}
    <div class="lh-grid__tiles">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- comment -%} Use the uploaded image, otherwise fall back to the product image {%- endcomment -%}
        {%- assign tile_image = block.settings.image | default: product.featured_image -%}

        <div class="lh-tile" {{ block.shopify_attributes }}>
          {%- if tile_image != blank -%}
            {{ tile_image | image_url: width: 800 | image_tag:
                loading: 'lazy', widths: '400, 600, 800',
                sizes: '(min-width: 750px) 30vw, 50vw',
                class: 'lh-tile__img', alt: tile_image.alt | default: product.title }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'lh-tile__img lh-tile__placeholder' }}
          {%- endif -%}

          {%- if product != blank -%}
            {%- comment -%} Hotspot: position is set per tile in the customizer {%- endcomment -%}
            <button type="button"
                    class="lh-tile__hotspot"
                    style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%;"
                    data-quick-view
                    data-product-handle="{{ product.handle }}"
                    aria-label="Quick view: {{ product.title | escape }}">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </button>

            {%- comment -%} Label {%- endcomment -%}
            <p class="lh-tile__label">
              <span>{{ product.title }}</span>
              <strong>{{ product.price | money }}</strong>
            </p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>

   {% render 'loomhaus-quick-view' %}
   
</section>

{% schema %}
{
  "name": "Loomhaus product grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loomhaus in the wild" },
    { "type": "text", "id": "hint", "label": "Hint text", "default": "Tap the + on any look to shop it." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Tile image (falls back to product image)" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "hotspot_x", "label": "Hotspot position: left (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "hotspot_y", "label": "Hotspot position: top (%)", "min": 0, "max": 100, "step": 1, "default": 40 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Loomhaus product grid",
      "blocks": [
        { "type": "tile", "settings": { "hotspot_x": 51, "hotspot_y": 30 } },
        { "type": "tile", "settings": { "hotspot_x": 55, "hotspot_y": 42 } },
        { "type": "tile", "settings": { "hotspot_x": 42, "hotspot_y": 36 } },
        { "type": "tile", "settings": { "hotspot_x": 51, "hotspot_y": 30 } },
        { "type": "tile", "settings": { "hotspot_x": 44, "hotspot_y": 55 } },
        { "type": "tile", "settings": { "hotspot_x": 52, "hotspot_y": 67 } }
      ]
    }
  ]
}
{% endschema %}