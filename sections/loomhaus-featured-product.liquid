{{ 'loomhaus-featured-product.css' | asset_url | stylesheet_tag }}
{%- assign product = section.settings.product | default: all_products['classic-varsity-top'] -%}
{%- if product != blank -%}
  {%- assign variant = product.selected_or_first_available_variant -%}

  {%- comment -%} Find which option position is colour and which is size (1-based) {%- endcomment -%}
  {%- assign color_pos = 0 -%}
  {%- assign size_pos = 0 -%}
  {%- for opt in product.options_with_values -%}
    {%- assign opt_name = opt.name | downcase -%}
    {%- if opt_name contains 'color' or opt_name contains 'colour' -%}{%- assign color_pos = opt.position -%}{%- endif -%}
    {%- if opt_name contains 'size' -%}{%- assign size_pos = opt.position -%}{%- endif -%}
  {%- endfor -%}

  {%- comment -%} Liquid does not allow filters inside [ ], so the 0-based indexes are worked out here {%- endcomment -%}
  {%- assign color_idx = color_pos | minus: 1 -%}
  {%- assign size_idx = size_pos | minus: 1 -%}

  {%- assign mf = product.metafields.custom -%}
  {%- assign colours = mf.colours.value -%}
  {%- assign ribbons = mf.size_ribbons.value -%}
  {%- assign offers = mf.offers.value -%}

  {%- comment -%} "Save X%" is worked out in Liquid (rounded to a whole number) {%- endcomment -%}
  {%- assign compare_price = variant.compare_at_price | default: 0 -%}
  {%- assign save_percent = 0 -%}
  {%- if compare_price > variant.price -%}
    {%- assign save_percent = compare_price | minus: variant.price | times: 100.0 | divided_by: compare_price | round -%}
  {%- endif -%}

  <section class="lh-section lh-fp" data-fp data-color-pos="{{ color_pos }}" data-size-pos="{{ size_pos }}">
    <div class="lh-container lh-fp__inner">

      {%- comment -%} ===== Gallery: main image, arrows, thumbnails ===== {%- endcomment -%}
      <div class="lh-fp__gallery">
        <div class="lh-fp__main">
          {%- comment -%} {{ product.images.first | image_url: width: 1200 | image_tag: loading: 'eager', class: 'lh-fp__main-img', alt: product.title, data-fp-main: true }} {%- endcomment -%}
          <img class="lh-fp__main-img"
     src="{{ product.images.first | image_url: width: 1200 }}"
     alt="{{ product.title | escape }}"
     width="1200" height="1440"
     loading="eager"
     data-fp-main>
          {%- if product.images.size > 1 -%}
            <button type="button" class="lh-fp__arrow lh-fp__arrow--prev" data-fp-prev aria-label="Previous image">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" class="lh-fp__arrow lh-fp__arrow--next" data-fp-next aria-label="Next image">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {%- endif -%}
        </div>

        <div class="lh-fp__thumbs">
          {%- for image in product.images limit: 6 -%}
            <button type="button" class="lh-fp__thumb{% if forloop.first %} is-active{% endif %}"
                    data-fp-thumb data-image-id="{{ image.id }}" data-full="{{ image | image_url: width: 1200 }}" aria-label="Show image {{ forloop.index }}">
              {{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} ===== Info column ===== {%- endcomment -%}
      <div class="lh-fp__info">

        {%- comment -%} Badge + rating (metafields) {%- endcomment -%}
        <div class="lh-fp__meta">
          {%- if mf.badge != blank -%}<span class="lh-fp__badge">{{ mf.badge }}</span>{%- endif -%}
          {%- if mf.rating != blank -%}
            <span class="lh-fp__rating">
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 .8l1.5 3.3 3.6.4-2.7 2.4.8 3.5L6 8.6l-3.2 1.8.8-3.5L.9 4.5l3.6-.4z" fill="currentColor"/></svg>
              {{ mf.rating.value | round: 1 }}
              {%- if mf.review_count != blank %} <small>({{ mf.review_count.value }} Reviews)</small>{% endif -%}
            </span>
          {%- endif -%}
        </div>

        <h2 class="lh-fp__title">{{ product.title }}</h2>

        {%- comment -%} Price block {%- endcomment -%}
        <div class="lh-fp__price">
          <strong data-fp-price>{{ variant.price | money }}</strong>
          <s data-fp-compare {% unless compare_price > variant.price %}hidden{% endunless %}>{{ compare_price | money }}</s>
          <span class="lh-fp__save" data-fp-save {% if save_percent == 0 %}hidden{% endif %}>Save {{ save_percent }}%</span>
        </div>
        <p class="lh-fp__tax">{{ section.settings.tax_note }}</p>

        {%- comment -%} Highlight box (metafields) {%- endcomment -%}
        {%- if mf.highlight_title != blank -%}
          <div class="lh-fp__highlight">
            <span class="lh-fp__check" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6.5l2.6 2.5L10 3.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div><strong>{{ mf.highlight_title }}</strong><small>{{ mf.highlight_text }}</small></div>
          </div>
        {%- endif -%}

        {%- comment -%} Colour swatches {%- endcomment -%}
        {%- if color_pos > 0 -%}
          {%- assign color_values = product.options_with_values[color_idx].values -%}
          {%- assign selected_color = variant.options[color_idx] -%}
          <div class="lh-fp__group">
            <span class="lh-fp__label">Color: <span data-fp-color-name>{{ selected_color }}</span></span>
            <div class="lh-fp__swatches">
              {%- for value in color_values -%}
                {%- comment -%} Default: colour name as a CSS colour. Metaobject hex overrides it {%- endcomment -%}
                {%- assign hex = value | downcase | replace: ' ', '' -%}
                {%- for c in colours -%}
                  {%- if c.name.value == value -%}{%- assign hex = c.hex.value -%}{%- endif -%}
                {%- endfor -%}
                <button type="button" class="lh-fp__swatch{% if value == selected_color %} is-selected{% endif %}"
                        data-fp-color="{{ value | escape }}" style="--swatch: {{ hex }};" aria-label="{{ value | escape }}"></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Size pills with ribbons {%- endcomment -%}
        {%- if size_pos > 0 -%}
          {%- assign size_values = product.options_with_values[size_idx].values -%}
          {%- assign selected_size = variant.options[size_idx] -%}
          <div class="lh-fp__group">
            <span class="lh-fp__label">Select size</span>
            <div class="lh-fp__sizes">
              {%- for value in size_values -%}
                {%- assign ribbon_label = '' -%}
                {%- for r in ribbons -%}
                  {%- if r.size.value == value -%}{%- assign ribbon_label = r.label.value -%}{%- endif -%}
                {%- endfor -%}
                <button type="button" class="lh-fp__size{% if value == selected_size %} is-selected{% endif %}" data-fp-size="{{ value | escape }}">
                  {%- if ribbon_label != blank -%}<em class="lh-fp__ribbon">{{ ribbon_label }}</em>{%- endif -%}
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Quantity + Add to cart {%- endcomment -%}
        <div class="lh-fp__buy">
          <div class="lh-fp__qty">
            <button type="button" data-fp-qty="-1" aria-label="Decrease quantity">&minus;</button>
            <span data-fp-qty-value>01</span>
            <button type="button" data-fp-qty="1" aria-label="Increase quantity">+</button>
          </div>
          <button type="button" class="lh-fp__add" data-fp-add>
            <span data-fp-add-label>Add to cart</span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <button type="button" class="lh-fp__now" data-fp-now>Buy it now</button>
        <p class="lh-fp__error" data-fp-error role="alert" hidden></p>

        {%- comment -%} Offer cards (metaobjects). "Get it for" is calculated in JS from the selected variant {%- endcomment -%}
        {%- if offers != blank -%}
          <div class="lh-fp__offers">
            {%- for offer in offers -%}
              <div class="lh-fp__offer" data-fp-offer data-percent="{{ offer.discount_percent.value }}">
                <span class="lh-fp__offer-icon" aria-hidden="true">%</span>
                <div class="lh-fp__offer-text">
                  <strong>Get it for <span data-fp-offer-price></span></strong>
                  <small>{{ offer.note.value }}</small>
                </div>
                <button type="button" class="lh-fp__copy" data-fp-copy="{{ offer.code.value | escape }}" aria-label="Copy code {{ offer.code.value | escape }}">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="4.5" y="4.5" width="7" height="7" rx="1.2" stroke="currentColor" stroke-width="1.2"/><path d="M9.5 4.5V3a1 1 0 00-1-1H3a1 1 0 00-1 1v5.5a1 1 0 001 1h1.5" stroke="currentColor" stroke-width="1.2"/></svg>
                </button>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Variant data for the JS (no extra network request needed) {%- endcomment -%}
    <script type="application/json" data-fp-data>
      {
        "selected": {{ variant.id }},
        "variants": [
          {%- for v in product.variants -%}
            {%- assign v_compare = v.compare_at_price | default: 0 -%}
            {
              "id": {{ v.id }},
              "options": {{ v.options | json }},
              "price": {{ v.price }},
              "compare": {{ v_compare }},
              "available": {{ v.available }},
              "imageId": {{ v.featured_image.id | default: 0 }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </section>

  <script src="{{ 'loomhaus-featured-product.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Loomhaus featured product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "tax_note", "label": "Tax note", "default": "MRP inclusive of all taxes" }
  ],
  "presets": [{ "name": "Loomhaus featured product" }]
}
{% endschema %}